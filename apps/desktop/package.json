{
  "name": "@deepwrite/desktop",
  "version": "1.9.0",
  "description": "DeepWrite local desktop writing client",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node ../../tools/ensure-electron-runtime.mjs",
    "dev": "node ../../tools/run-desktop-dev.mjs",
    "build": "electron-vite build && node ../../tools/check-renderer-build.mjs",
    "prepreview": "node ../../tools/ensure-electron-runtime.mjs",
    "preview": "node ../../tools/run-desktop-preview.mjs",
    "presmoke": "node ../../tools/ensure-electron-runtime.mjs",
    "smoke": "node scripts/electron-smoke.mjs"
  },
  "dependencies": {
    "qrcode": "catalog:"
  },
  "devDependencies": {
    "@deepwrite/contracts": "workspace:*",
    "@deepwrite/pi-runtime-adapter": "workspace:*",
    "@deepwrite/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/markdown-it": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-updater": "catalog:",
    "electron-vite": "catalog:",
    "markdown-it": "catalog:",
    "naive-ui": "catalog:",
    "pdfjs-dist": "catalog:",
    "pinia": "catalog:",
    "prosemirror-commands": "catalog:",
    "prosemirror-inputrules": "catalog:",
    "prosemirror-keymap": "catalog:",
    "prosemirror-markdown": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-schema-list": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-tables": "catalog:",
    "prosemirror-view": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-tsc": "catalog:"
  }
}
